[Unit]
Description=LocNet coordination server
Documentation=https://github.com/mahantsunandan/locnet
After=network-online.target
Wants=network-online.target

# Never give up restarting. A hub abandoned by systemd after five quick
# failures is one you find out about when nothing can join.
StartLimitIntervalSec=0

[Service]
Type=simple
# $LOCNET_HUB_FLAGS is unbraced on purpose: systemd splits it into separate
# arguments, and an unset one becomes none at all (braced, it would be one
# empty argument, which ends flag parsing).
EnvironmentFile=/etc/locnet/hub.env
ExecStart=/usr/local/bin/locnet-hub serve \
    -listen ${LOCNET_LISTEN} \
    -advertise ${LOCNET_ADVERTISE} \
    -network ${LOCNET_NETWORK} \
    -prefix ${LOCNET_PREFIX} \
    $LOCNET_HUB_FLAGS
Restart=always
RestartSec=5

# The hub is the one component that does not need root: it owns no interface
# and holds no tunnel keys. Running it as root would be giving away a security
# property for nothing.
User=locnet-hub
Group=locnet-hub

# The one privilege it does take: binding ports 80 and 443, for WebShare
# (locnet-hub webshare). Nothing listens there until a domain is configured,
# and this capability allows binding low ports and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StateDirectory=locnet-hub
StateDirectoryMode=0700

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
